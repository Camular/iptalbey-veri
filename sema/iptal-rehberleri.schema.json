{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Camular/iptalbey-veri/main/sema/iptal-rehberleri.schema.json",
  "title": "İptalBey iptal rehberleri",
  "type": "object",
  "additionalProperties": false,
  "required": ["sema_surumu", "surum", "guncelleme", "rehberler"],
  "properties": {
    "sema_surumu": { "const": 1 },
    "surum": { "type": "integer", "minimum": 1 },
    "guncelleme": { "$ref": "#/$defs/tarih" },
    "rehberler": { "type": "array", "items": { "$ref": "#/$defs/rehber" } }
  },
  "$defs": {
    "tarih": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "rehber": {
      "type": "object",
      "additionalProperties": false,
      "required": ["servis", "yollar", "notlar"],
      "properties": {
        "servis": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "yollar": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/yol" } },
        "notlar": { "type": ["string", "null"] }
      }
    },
    "yol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kanal", "adimlar", "kaynak", "kontrol_tarihi"],
      "properties": {
        "kanal": { "enum": ["web", "google_play", "app_store", "operator", "musteri_hizmetleri"] },
        "adimlar": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "kaynak": { "type": "string", "pattern": "^https://" },
        "kontrol_tarihi": { "$ref": "#/$defs/tarih" }
      }
    }
  }
}
